    "deny": [
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/wallet/**)",
      "Read(**/cwallet.sso)",
      "Read(~/.ssh/**)",
      "Bash(git checkout master)",
      "Bash(git checkout main)",
      "Bash(git checkout develop)",
      "Bash(git switch master)",
      "Bash(git switch main)",
      "Bash(git switch develop)",
      "Bash(git push * master)",
      "Bash(git push * main)",
      "Bash(git push * develop)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(pkexec *)",
      "Bash(:|*)",
      "Bash(mkfs *)",
      "Bash(> /dev *)",
      "Bash(python3 -c *urllib*)",
      "Bash(python3 -c *requests*)",
      "Bash(python3 -c *http*)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(.env.production)",
      "Write(*.pem)",
      "Write(*id_rsa*)",
      "Write(*id_ed25519*)",
      "Write(*credentials*)",
      "Write(*secret*)",
      "Edit(.env.production)",
      "Edit(*.pem)",
      "Edit(*id_rsa*)",
      "Edit(*id_ed25519*)",
      "Edit(*credentials*)",
      "Edit(*secret*)",
      "Bash(cat *.env*)",
      "Bash(cat */.env*)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(/usr/bin/sudo *)",
      "Bash(doas *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(dd if *)",
      "Bash(crontab *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(socat *)",
      "Bash(curl * | python3 *)",
      "Bash(curl * | sh *)",
      "Bash(curl * | bash *)",
      "Bash(wget *)",
      "Write(/etc/*)",
      "Write(/usr/*)",
      "Write(/System/*)",
      "Write(/var/*)",
      "Write(/bin/*)",
      "Write(/sbin/*)",
      "Write(~/.ssh/*)",
      "Edit(~/.ssh/*)"
    ],
    "ask": ["EnterWorktree"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/enforce-npm.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/read-hook.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ${CLAUDE_PROJECT_DIR}/statusline-command.sh"
  },
  "enabledPlugins": {
    "jc@the-jagoda-toolkit": true,
    "typescript-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "codex@openai-codex": true,
    "hookify@claude-code-plugins": true,
    "caveman@caveman": true,
    "atlassian@claude-plugins-official": true,
    "github@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "the-jagoda-toolkit": {
      "source": {
        "source": "github",
        "repo": "Jagoda11/the-jagoda-toolkit"
      },
      "autoUpdate": true
    },
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "outputStyle": "Architect",
  "effortLevel": "high",
  "tui": "default",
  "theme": "light"
}
